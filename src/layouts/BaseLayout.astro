---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { siteMeta } from '../data/siteMeta';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  canonicalPath?: string;
}

const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  ogImage = '/images/flx/facility-main.jpg',
  canonicalPath = Astro.url.pathname,
} = Astro.props;

// Canonical and OG URLs must be absolute. siteMeta.siteUrl is the single
// source of truth for the production domain.
const canonicalUrl = new URL(canonicalPath, siteMeta.siteUrl).href;
const ogImageUrl = new URL(ogImage, siteMeta.siteUrl).href;
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<meta property="og:title" content={ogTitle}>
<meta property="og:description" content={ogDescription}>
<meta property="og:type" content="website">
<meta property="og:url" content={canonicalUrl}>
<meta property="og:image" content={ogImageUrl}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={ogTitle}>
<meta name="twitter:description" content={ogDescription}>
<meta name="twitter:image" content={ogImageUrl}>
<link rel="canonical" href={canonicalUrl} />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;800&family=Archivo:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css" />
</head>
<body>

<Nav />

<main id="top">
  <slot />
</main>

<!-- ===== GRAIN ===== -->
<div class="grain" aria-hidden="true"></div>
<!-- ===== SCROLL PROGRESS ===== -->
<div class="progress" id="progress" aria-hidden="true"></div>
<!-- ===== STICKY MOBILE BAR ===== -->
<div class="mbar" id="mbar">
  <a class="btn btn-primary" href="https://app.courtreserve.com/Online/Memberships/Public/9518" target="_blank" rel="noopener">Book a Court
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
  <a class="btn btn-ghost" href={siteMeta.phoneHref}>Call Us</a>
</div>
<!-- ===== BACK TO TOP ===== -->
<button class="totop" id="totop" aria-label="Back to top">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
</button>

<Footer />

<script>
  /* Seamless ticker loop */
  const track = document.getElementById('tickerTrack');
  if (track) track.innerHTML += track.innerHTML;

  /* Nav scroll state */
  const header = document.getElementById('header');
  const onScroll = () => { if (header) header.classList.toggle('scrolled', window.scrollY > 24); };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  /* Mobile menu (header burger) */
  const burger = document.getElementById('burger');
  const menu = document.getElementById('mobileMenu');
  if (burger && menu) {
    burger.addEventListener('click', () => {
      const open = menu.classList.toggle('open');
      document.body.classList.toggle('menu-open', open);
      burger.setAttribute('aria-expanded', String(open));
    });
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => {
      menu.classList.remove('open');
      document.body.classList.remove('menu-open');
      burger.setAttribute('aria-expanded', 'false');
    }));
  }

  /* Standalone always-visible mobile burger */
  (function () {
    const btn = document.getElementById('sbBurger');
    const menuEl = document.getElementById('mobileMenu');
    if (!btn || !menuEl) return;
    btn.addEventListener('click', function () {
      const open = menuEl.classList.toggle('open');
      document.body.classList.toggle('menu-open', open);
      btn.classList.toggle('open', open);
    });
    menuEl.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () {
        menuEl.classList.remove('open');
        document.body.classList.remove('menu-open');
        btn.classList.remove('open');
      });
    });
  })();

  /* Scroll reveals */
  const io = new IntersectionObserver((es) => {
    es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
  }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

  /* Layered hero parallax: scroll + gentle pointer drift (desktop, motion-safe) */
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const desktop = window.matchMedia('(min-width:900px)').matches;
  const court = document.getElementById('heroCourt');
  const court2 = document.getElementById('heroCourt2');
  const inner = document.getElementById('heroInner');
  let sy = 0, mx = 0, my = 0, raf: number | null = null;
  function applyHero() {
    if (court) (court as HTMLElement).style.transform = `translate(${mx * 14}px,${sy * 0.07 + my * 10}px)`;
    if (court2) (court2 as HTMLElement).style.transform = `translate(${mx * 26}px,${sy * 0.12 + my * 18}px)`;
    if (inner) (inner as HTMLElement).style.transform = `translate(${mx * -6}px,${my * -4}px)`;
    raf = null;
  }
  function queueHero() { if (!raf) raf = requestAnimationFrame(applyHero); }
  if (!reduce && desktop) {
    window.addEventListener('scroll', () => { sy = Math.min(window.scrollY, window.innerHeight); queueHero(); }, { passive: true });
    document.querySelector('.hero')?.addEventListener('pointermove', (e) => {
      const pe = e as PointerEvent;
      mx = (pe.clientX / window.innerWidth - 0.5);
      my = (pe.clientY / window.innerHeight - 0.5);
      queueHero();
    }, { passive: true });
  }

  /* Scroll progress bar, sticky mobile bar, back-to-top */
  const prog = document.getElementById('progress');
  const mbar = document.getElementById('mbar');
  const totop = document.getElementById('totop');
  function chromeTick() {
    const scrollY = window.scrollY;
    const docH = document.documentElement.scrollHeight - window.innerHeight;
    if (prog) (prog as HTMLElement).style.width = (docH > 0 ? Math.min(100, (scrollY / docH) * 100) : 0) + '%';
    if (mbar) mbar.classList.toggle('up', scrollY > 120);
    if (totop) totop.classList.toggle('show', scrollY > 600);
  }
  window.addEventListener('scroll', chromeTick, { passive: true });
  chromeTick();
  totop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

  /* Pro shop video: play only when visible (saves bandwidth) */
  const shopVid = document.getElementById('shopVideo') as HTMLVideoElement | null;
  if (shopVid) {
    const shopObs = new IntersectionObserver((es) => {
      es.forEach((e) => (e.isIntersecting ? shopVid.play().catch(() => {}) : shopVid.pause()));
    }, { threshold: 0.15 });
    shopObs.observe(shopVid);
    if (window.matchMedia('(prefers-reduced-motion:reduce)').matches) {
      shopVid.pause();
      shopVid.removeAttribute('autoplay');
    }
  }

  /* Pause hero video when tab hidden */
  const heroVid = document.getElementById('heroVideo') as HTMLVideoElement | null;
  if (heroVid) {
    document.addEventListener('visibilitychange', () => {
      document.hidden ? heroVid.pause() : heroVid.play().catch(() => {});
    });
    if (window.matchMedia('(prefers-reduced-motion:reduce)').matches) {
      heroVid.pause();
      heroVid.removeAttribute('autoplay');
    }
  }

  /* Active nav link on scroll */
  const sections = [...document.querySelectorAll('section[id],div[id="top"]')];
  const navLinks = [...document.querySelectorAll('nav.links a')];
  const navObs = new IntersectionObserver((es) => {
    es.forEach((e) => {
      if (e.isIntersecting) {
        navLinks.forEach((a) => a.classList.toggle('active', a.getAttribute('href') === '#' + e.target.id));
      }
    });
  }, { threshold: 0.35 });
  sections.forEach((s) => s.id && navObs.observe(s));

  /* Contact form (front-end only; connect a form provider before launch) */
  const _cf = document.getElementById('contactForm');
  if (_cf) _cf.addEventListener('submit', (e) => {
    e.preventDefault();
    const note = document.getElementById('formNote');
    if (note) note.innerHTML = 'Thanks — while the online form is being set up, call <a href="tel:6077352965" style="color:var(--text);text-decoration:underline">607-735-2965</a> or message the club on Facebook and we\'ll get right back to you.';
  });
</script>

</body>
</html>
