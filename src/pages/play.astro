---
import BaseLayout from '../layouts/BaseLayout.astro';
import CourtReserveButton from '../components/CourtReserveButton.astro';

const title = 'Play Pickleball in Horseheads NY | Open Play, Court Rentals & Lessons | FLX Pickleball Club';
const description = 'Drop-in open play, private court rentals, and professional pickleball lessons in Horseheads, NY. Book online any day. All ages and levels welcome.';
---

<BaseLayout title={title} description={description}>

<!-- PLAY PAGE HERO -->
<section class="page-hero">
  <div class="page-hero-bg">
    <img src="/images/flx/hero-courts.jpg" alt="Players on court during open play at FLX Pickleball Club" style="object-position:50% 55%;filter:brightness(0.88) contrast(1.10)">
  </div>
  <div class="wrap page-hero-inner">
    <p class="eyebrow">Ways to Play</p>
    <h1>Open Play.<br>Rentals.<br><span style="color:transparent;-webkit-text-stroke:1.5px var(--cobalt-hi)">Lessons.</span></h1>
    <p class="lede">Everything about actually getting on the court — drop in any day, reserve a private court, or sharpen your game with one of our coaches.</p>
    <div class="hero-actions">
      <CourtReserveButton to="bookCourt" label="Book on CourtReserve" />
      <a class="btn btn-ghost" href="#lessons">Meet Our Coaches</a>
    </div>
  </div>
</section>

<!-- OPEN PLAY SECTION -->
<section class="light" id="open-play">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow">Open Play</p>
      <h2 class="display">Show up. Rotate in.<br><span class="serif">Play.</span></h2>
      <p class="lede">Seven days a week the courts fill with rotating games at every skill level. Come alone or with friends — open play is the heartbeat of FLX and everyone gets court time.</p>
    </div>
    <div class="three-grid">
      <div class="media m-b" style="position:relative;overflow:hidden;border-radius:6px;border:1px solid var(--line)">
        <div class="art" aria-hidden="true"></div>
        <div class="lines" aria-hidden="true" style="position:absolute;inset:0;opacity:.4;z-index:1"><svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice"><line x1="0" y1="150" x2="400" y2="150" stroke="rgba(240,241,238,.18)" stroke-width="2"/><line x1="0" y1="80" x2="400" y2="80" stroke="rgba(240,241,238,.12)" stroke-width="1"/><line x1="0" y1="220" x2="400" y2="220" stroke="rgba(240,241,238,.12)" stroke-width="1"/></svg></div>
        <img src="/images/flx/program-open-play.jpg" alt="Open play action at FLX" loading="lazy" decoding="async" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:2" onerror="this.style.display='none'">
        <div style="position:absolute;inset:0;z-index:3;background:linear-gradient(0deg,rgba(11,14,19,.82) 0%,rgba(11,14,19,.2) 55%,transparent 100%)"></div>
        <div style="position:absolute;z-index:5;left:18px;bottom:16px"><b style="display:block;font:700 1rem/1.2 var(--body);color:#fff">All Levels Welcome</b><span style="font:500 .88rem/1.4 var(--body);color:rgba(240,241,238,.78)">Beginner to competitive</span></div>
      </div>
      <div class="media m-a" style="position:relative;overflow:hidden;border-radius:6px;border:1px solid var(--line)">
        <div class="art" aria-hidden="true"></div>
        <div class="lines" aria-hidden="true" style="position:absolute;inset:0;opacity:.4;z-index:1"><svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice"><line x1="0" y1="150" x2="400" y2="150" stroke="rgba(240,241,238,.18)" stroke-width="2"/><line x1="0" y1="80" x2="400" y2="80" stroke="rgba(240,241,238,.12)" stroke-width="1"/><line x1="0" y1="220" x2="400" y2="220" stroke="rgba(240,241,238,.12)" stroke-width="1"/></svg></div>
        <img src="/images/flx/facility-main.jpg" alt="FLX indoor courts" loading="lazy" decoding="async" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:2" onerror="this.style.display='none'">
        <div style="position:absolute;inset:0;z-index:3;background:linear-gradient(0deg,rgba(11,14,19,.82) 0%,rgba(11,14,19,.2) 55%,transparent 100%)"></div>
        <div style="position:absolute;z-index:5;left:18px;bottom:16px"><b style="display:block;font:700 1rem/1.2 var(--body);color:#fff">Open 7 Days</b><span style="font:500 .88rem/1.4 var(--body);color:rgba(240,241,238,.78)">Morning, afternoon &amp; evening</span></div>
      </div>
      <div class="media m-c" style="position:relative;overflow:hidden;border-radius:6px;border:1px solid var(--line)">
        <div class="art" aria-hidden="true"></div>
        <div class="lines" aria-hidden="true" style="position:absolute;inset:0;opacity:.4;z-index:1"><svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice"><line x1="0" y1="150" x2="400" y2="150" stroke="rgba(240,241,238,.18)" stroke-width="2"/><line x1="0" y1="80" x2="400" y2="80" stroke="rgba(240,241,238,.12)" stroke-width="1"/><line x1="0" y1="220" x2="400" y2="220" stroke="rgba(240,241,238,.12)" stroke-width="1"/></svg></div>
        <img src="/images/flx/community-candid.jpg" alt="FLX community" loading="lazy" decoding="async" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:2" onerror="this.style.display='none'">
        <div style="position:absolute;inset:0;z-index:3;background:linear-gradient(0deg,rgba(11,14,19,.82) 0%,rgba(11,14,19,.2) 55%,transparent 100%)"></div>
        <div style="position:absolute;z-index:5;left:18px;bottom:16px"><b style="display:block;font:700 1rem/1.2 var(--body);color:#fff">Meet the Community</b><span style="font:500 .88rem/1.4 var(--body);color:rgba(240,241,238,.78)">Show up a stranger, leave with a game</span></div>
      </div>
    </div>
    <div class="play-pricing">
      <div class="pp-row"><span>Non-Member Open Play</span><strong>$10.00 per session</strong></div>
      <div class="pp-row"><span>Member Open Play</span><strong>$7.00 per session</strong></div>
      <div class="pp-cta">
        <CourtReserveButton to="bookCourt" label="Sign Up on CourtReserve" />
        <a class="btn btn-ghost" href="/membership">View Membership Options</a>
      </div>
    </div>
  </div>
</section>

<!-- COURTRESERVE SCHEDULE WIDGET -->
<section class="light" id="schedule">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow">Live Schedule</p>
      <h2 class="display">What's on<br><span class="serif">this week.</span></h2>
      <p class="lede">Today's open play sessions, clinics, and events — updated live. Click any event to sign up directly through CourtReserve.</p>
    </div>
    <div class="widget-wrap">
      <iframe
        id="form-iframe"
        class="form-iframe-104607"
        src="https://widgets.courtreserve.com/Online/Public/EmbedCode/9518/104607"
        style="margin:0;width:100%;border:none;overflow:hidden;"
        scrolling="no"
        title="FLX Pickleball Club Daily Schedule"
        loading="lazy">
      </iframe>
      <script type="text/javascript" is:inline>
        var myEventMethod = window.addEventListener ? "addEventListener" : "attachEvent";
        var myEventListener = window[myEventMethod];
        var myEventMessage = myEventMethod == "attachEvent" ? "onmessage" : "message";
        function onEventClick(eventId, occId) {}
        myEventListener(myEventMessage, function(e) {
          switch (e.data.action) {
            case "setHeight": {
              var embedCodeId = e.data.embedCodeId;
              if (embedCodeId != null && embedCodeId != '') {
                var elements = document.getElementsByClassName('form-iframe-' + embedCodeId);
                for (var i = 0; i < elements.length; i++) {
                  elements[i].style.height = (e.data.height) + "px";
                }
              } else {
                document.getElementById('form-iframe').height = (e.data.height) + "px";
              }
              break;
            }
            case "eventClick": {
              var eventId = e.data.params.eventId;
              var reservationId = e.data.params.reservtionId;
              onEventClick(eventId, reservationId);
              break;
            }
          }
        }, false);
      </script>
    </div>
  </div>
</section>

<!-- COURT RENTALS SECTION -->
<section id="court-rentals">
  <div class="wrap">
    <div class="head split">
      <div><p class="eyebrow">Court Rentals</p><h2 class="display">Your court.<br><span class="serif">Your hour.</span></h2></div>
      <p class="lede" style="margin-top:0">Reserve a private court for your group, family, birthday, or focused practice session.</p>
    </div>
    <div style="display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(36px,5vw,72px);align-items:center;margin-top:clamp(44px,5vw,66px)">
      <div style="display:flex;flex-direction:column;gap:12px">
        <div style="position:relative;overflow:hidden;border-radius:8px;border:1px solid var(--line);aspect-ratio:16/9;box-shadow:var(--shadow)">
          <img src="/images/flx/event-birthday.jpg" alt="Birthday party at FLX Pickleball Club" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover;object-position:50% 35%;display:block">
          <div style="position:absolute;inset:0;background:linear-gradient(0deg,rgba(11,14,19,.72) 0%,rgba(11,14,19,.18) 55%,transparent 100%)"></div>
          <div style="position:absolute;left:18px;bottom:14px;z-index:2">
            <b style="display:block;font:700 .98rem/1.2 var(--body);color:#fff">Birthdays &amp; Celebrations</b>
            <span style="font:500 .85rem/1.4 var(--body);color:rgba(240,241,238,.8)">Rent the courts, we'll set up the fun</span>
          </div>
        </div>
        <div style="position:relative;overflow:hidden;border-radius:8px;border:1px solid var(--line);aspect-ratio:16/9;box-shadow:var(--shadow)">
          <img src="/images/flx/event-holiday.jpg" alt="Holiday event at FLX Pickleball Club" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover;object-position:50% 38%;display:block">
          <div style="position:absolute;inset:0;background:linear-gradient(0deg,rgba(11,14,19,.72) 0%,rgba(11,14,19,.18) 55%,transparent 100%)"></div>
          <div style="position:absolute;left:18px;bottom:14px;z-index:2">
            <b style="display:block;font:700 .98rem/1.2 var(--body);color:#fff">Group &amp; Special Events</b>
            <span style="font:500 .85rem/1.4 var(--body);color:rgba(240,241,238,.8)">The whole club comes together</span>
          </div>
        </div>
        <div style="position:relative;overflow:hidden;border-radius:8px;border:1px solid var(--line);aspect-ratio:16/9;box-shadow:var(--shadow)">
          <img src="/images/flx/court-rental.jpg" alt="Players on a private court rental at FLX Pickleball Club" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover;object-position:50% 42%;display:block">
          <div style="position:absolute;inset:0;background:linear-gradient(0deg,rgba(11,14,19,.72) 0%,rgba(11,14,19,.15) 55%,transparent 100%)"></div>
          <div style="position:absolute;left:18px;bottom:14px;z-index:2">
            <b style="display:block;font:700 .98rem/1.2 var(--body);color:#fff">Private Court — Your Group</b>
            <span style="font:500 .85rem/1.4 var(--body);color:rgba(240,241,238,.8)">No rotating in. No waiting.</span>
          </div>
        </div>
      </div>
      <div>
        <div style="display:flex;flex-direction:column;gap:14px">
          <div class="pg-card" style="background:var(--coal-3)"><h3>Private Groups &amp; Friends</h3><p>Grab your foursome and have a full court to yourselves — no rotating in, no waiting.</p></div>
          <div class="pg-card" style="background:var(--coal-3)"><h3>Birthdays &amp; Special Events</h3><p>Rent the courts for a birthday, team outing, or group celebration. We'll set up the games.</p></div>
          <div class="pg-card" style="background:var(--coal-3)"><h3>Practice &amp; Drills</h3><p>Private court time plus optional ball machine add-on. Focused, distraction-free reps.</p></div>
        </div>
        <div class="play-pricing" style="margin-top:24px">
          <div class="pp-row"><span>Non-Member Rental</span><strong>$40.00 / hour</strong></div>
          <div class="pp-row"><span>Member Rental</span><strong>$20.00 / hour</strong></div>
          <div class="pp-row"><span>Ball Machine Add-On</span><strong>$10.00 / hr + court</strong></div>
          <div class="pp-cta">
            <CourtReserveButton to="bookCourt" label="Reserve a Court" />
            <a class="btn btn-ghost" href="tel:6077352965">Call 607-735-2965</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- LESSONS SECTION -->
<section class="light" id="lessons">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow">Lessons &amp; Clinics</p>
      <h2 class="display">Coaching that actually<br><span class="serif">changes your game.</span></h2>
      <p class="lede">Private lessons and small-group clinics built around how you actually play — every level, every goal.</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:clamp(44px,5vw,66px)">
      <div class="coach-card">
        <div class="coach-photo">
          <img src="/images/flx/coach-tim-klee.jpg" alt="Tim Klee, Head Instructor at FLX Pickleball Club" style="width:100%;height:100%;object-fit:cover;object-position:50% 18%;display:block">
        </div>
        <div class="coach-body">
          <h3>Tim Klee</h3>
          <span class="coach-role">Head Instructor</span>
          <p>Years of competitive and coaching experience. Tim tailors every lesson to where you are in your game — and where you want to go.</p>
          <a class="go" href="https://app.courtreserve.com/Online/Memberships/Public/9518" target="_blank" rel="noopener"><span>Book with Tim</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>
      </div>
      <div class="coach-card">
        <div class="coach-photo">
          <img src="/images/flx/coach-chris-cahn.jpg" alt="Chris Cahn, pickleball instructor at FLX Pickleball Club" style="width:100%;height:100%;object-fit:cover;object-position:50% 22%;display:block">
        </div>
        <div class="coach-body">
          <h3>Chris Cahn</h3>
          <span class="coach-role">Instructor</span>
          <p>Specializes in making the game click for newer players. The fundamentals, kitchen rules, and strategy that separate players who rally from players who win.</p>
          <a class="go" href="https://app.courtreserve.com/Online/Memberships/Public/9518" target="_blank" rel="noopener"><span>Book with Chris</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>
      </div>
      <div class="coach-card">
        <div class="coach-photo">
          <img src="/images/flx/coach-jarod-parker.jpg" alt="Jarod Parker, pickleball instructor at FLX Pickleball Club" style="width:100%;height:100%;object-fit:cover;object-position:50% 15%;display:block">
        </div>
        <div class="coach-body">
          <h3>Jarod Parker</h3>
          <span class="coach-role">Instructor</span>
          <p>Works with competitive players pushing their rating and players tired of losing to their friends. Focused, direct coaching on the parts of the game most people ignore.</p>
          <a class="go" href="https://app.courtreserve.com/Online/Memberships/Public/9518" target="_blank" rel="noopener"><span>Book with Jarod</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>
      </div>
    </div>
    <p style="margin-top:clamp(30px,4vw,46px);text-align:center;font:500 1.05rem/1.6 var(--body);color:var(--muted-d)">Not sure which coach is right for you? <a href="tel:6077352965" style="color:var(--cobalt);border-bottom:1px solid var(--cobalt);padding-bottom:1px">Call 607-735-2965</a> and we'll point you in the right direction.</p>
  </div>
</section>

<!-- FINAL CTA -->
<div class="play-final">
  <div class="wrap">
    <h2 class="play-final-h">Get on the court.</h2>
    <p class="play-final-sub">Book. Play. Improve. Repeat.</p>
    <p class="play-final-desc">Open play, court rentals, and lessons are all on CourtReserve — or call us and we'll get you sorted.</p>
    <div class="ctas">
      <CourtReserveButton to="bookCourt" label="Book on CourtReserve" />
      <a class="btn btn-ghost" href="tel:6077352965">Call 607-735-2965</a>
    </div>
  </div>
</div>

<style>
.play-pricing {
  margin-top: clamp(34px, 4vw, 48px);
  border: 1px solid var(--line);
  border-radius: 8px;
  overflow: hidden;
  background: #fff;
}
.pp-row {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 18px;
  padding: 18px 22px;
  border-bottom: 1px solid var(--line);
  align-items: center;
  font-size: 0.95rem;
}
.pp-row span {
  color: var(--ink);
  font-weight: 500;
}
.pp-row strong {
  color: var(--cobalt-hi);
  font-weight: 700;
}
.pp-cta {
  padding: 16px 22px;
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
}
.pp-cta .btn {
  flex: 1;
}
.pg-card {
  border: 1px solid var(--line);
  border-radius: 6px;
  padding: 22px 24px;
  transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
}
.pg-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow);
}
.pg-card h3 {
  font: 700 1.1rem/1.2 var(--body);
  color: var(--text);
  margin: 0 0 8px 0;
}
.pg-card p {
  color: var(--muted);
  font-size: 0.95rem;
  line-height: 1.6;
  margin: 0;
}
.coach-card {
  background: var(--coal-3);
  border: 1px solid var(--line);
  border-radius: 6px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
}
.coach-card:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow);
}
.coach-photo {
  aspect-ratio: 16/12;
  position: relative;
  overflow: hidden;
}
.coach-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.coach-body {
  padding: 22px 20px;
  display: flex;
  flex-direction: column;
}
.coach-body h3 {
  font: 700 1.1rem/1.2 var(--body);
  color: var(--text);
  margin: 0 0 4px 0;
}
.coach-role {
  font: 500 0.88rem/1.3 var(--body);
  color: var(--cobalt-hi);
  display: block;
  margin-bottom: 12px;
}
.coach-body p {
  color: var(--muted);
  font-size: 0.93rem;
  line-height: 1.6;
  flex: 1;
  margin: 0 0 12px 0;
}
.coach-body .go {
  margin-top: auto;
  font: 600 11.5px/1 var(--body);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--text);
  display: inline-flex;
  align-items: center;
  gap: 9px;
}
.coach-body .go svg {
  width: 13px;
  height: 13px;
  color: var(--cobalt-hi);
  transition: transform 0.35s var(--ease);
}
.coach-body .go:hover svg {
  transform: translateX(5px);
}
.three-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-top: clamp(44px, 5vw, 66px);
}
@media (max-width: 900px) {
  .three-grid {
    grid-template-columns: 1fr;
  }
}
.ctas {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
  margin-top: 30px;
}
.play-final {
  background: var(--coal);
  padding: clamp(80px, 10vw, 140px) 0;
  text-align: center;
}
.play-final-h {
  font: 800 clamp(2.8rem, 6vw, 5rem)/1 var(--display);
  text-transform: uppercase;
  color: var(--text);
  margin: 0 0 16px 0;
}
.play-final-sub {
  font: 500 clamp(1.4rem, 3vw, 2.2rem)/1.3 var(--serif);
  color: var(--cobalt-hi);
  font-style: italic;
  margin: 0 0 16px 0;
}
.play-final-desc {
  font: 400 1rem/1.6 var(--body);
  color: var(--muted);
  margin: 0 0 32px 0;
}
.play-final .ctas {
  justify-content: center;
}
.widget-wrap {
  margin-top: clamp(44px, 5vw, 66px);
  border: 1px solid var(--line);
  border-radius: 8px;
  overflow: hidden;
  background: #fff;
  min-height: 400px;
}
</style>

</BaseLayout>
