---
import BaseLayout from '../layouts/BaseLayout.astro';
import CourtReserveButton from '../components/CourtReserveButton.astro';

const title = 'Membership Plans & Pricing | FLX Pickleball Club';
const description = 'Affordable membership plans for pickleball players in Horseheads, NY. Monthly, annual, and free options. Member pricing on open play and court rentals.';
---

<BaseLayout title={title} description={description}>

<!-- MEMBERSHIP PAGE HERO -->
<section class="page-hero">
  <div class="page-hero-bg">
    <img src="/images/flx/community-between-games.jpg" alt="FLX Pickleball Club members between games" style="object-position:50% 40%;filter:brightness(0.75) contrast(1.10)">
  </div>
  <div class="wrap page-hero-inner">
    <p class="eyebrow">Membership &amp; Pricing</p>
    <h1>Play more.<br><span style="color:transparent;-webkit-text-stroke:1.5px var(--cobalt-hi)">Pay less.</span></h1>
    <p class="lede">A $15/month membership cuts your open play cost almost in half and drops court rentals by 50%. No long-term contract — just 30 days at a time.</p>
    <div class="hero-actions">
      <CourtReserveButton to="membershipMonthly" label="Join on CourtReserve" />
      <a class="btn btn-ghost" href="tel:6077352965">Call With Questions</a>
    </div>
  </div>
</section>

<!-- PRICING SECTION -->
<section id="plans">
  <div class="wrap">
    <div class="pricing-head">
      <div class="pricing-head-left">
        <p class="eyebrow">Pricing</p>
        <h2 class="display">Simple. Honest.<br><span class="serif">Worth it.</span></h2>
      </div>
      <p class="pricing-head-right">Two ways to play. No hidden fees. The member price pays for itself after two open play sessions a month.</p>
    </div>

    <!-- PRICING CARDS -->
    <div class="pcard-grid">

      <!-- FREE / NON-MEMBER -->
      <div class="pcard">
        <span class="pcard-badge">No Commitment</span>
        <h3 class="pcard-title">Non-Member</h3>
        <div class="pcard-price">
          <span class="pcard-dollar">Free</span>
          <span class="pcard-period">to register</span>
        </div>
        <p class="pcard-desc">Create a free CourtReserve account and start playing at standard rates. No membership fee, no commitment.</p>
        <ul class="pcard-features">
          <li><span class="feat-label">Open Play Sessions —</span><strong>$10.00</strong></li>
          <li><span class="feat-label">Court Rentals —</span><strong>$40.00 / hr</strong></li>
          <li><span class="feat-label">Ball Machine —</span><strong>$10/hr + court rental</strong></li>
          <li><span class="feat-label">Reserve up to</span><strong>60 days</strong><span class="feat-label">in advance</span></li>
          <li><span class="feat-label">Additional benefits included</span></li>
        </ul>
        <div class="pcard-actions">
          <CourtReserveButton to="membershipFree" label="Create Free Account" />
        </div>
      </div>

      <!-- MONTHLY MEMBER -->
      <div class="pcard pcard--featured">
        <span class="pcard-badge pcard-badge--blue">Best Value</span>
        <h3 class="pcard-title">Monthly Member</h3>
        <div class="pcard-price">
          <span class="pcard-dollar-sign">$</span><span class="pcard-amount">15</span><span class="pcard-period">/mo</span>
        </div>
        <p class="pcard-desc">30-day membership. Pay as you go, no long-term commitment. Save on every session and rental all month.</p>
        <ul class="pcard-features">
          <li><span class="feat-label">Open Play Sessions —</span><strong>$7.00</strong></li>
          <li><span class="feat-label">Court Rentals —</span><strong>$20.00 / hr</strong></li>
          <li><span class="feat-label">Ball Machine —</span><strong>$10/hr + court rental</strong></li>
          <li><span class="feat-label">Reserve up to</span><strong>60 days</strong><span class="feat-label">in advance</span></li>
          <li><span class="feat-label">Additional benefits included</span></li>
        </ul>
        <div class="pcard-actions">
          <CourtReserveButton to="membershipMonthly" label="Join Now — $15/Mo" />
        </div>
      </div>

      <!-- ANNUAL MEMBER -->
      <div class="pcard">
        <span class="pcard-badge">Best Annual Value</span>
        <h3 class="pcard-title">Annual Member</h3>
        <div class="pcard-price">
          <span class="pcard-dollar-sign">$</span><span class="pcard-amount">150</span><span class="pcard-period">/yr</span>
        </div>
        <p class="pcard-desc">Yearly membership, runs for 1 full year from purchase date. Same great member rates as monthly — one payment, done for the year.</p>
        <ul class="pcard-features">
          <li><span class="feat-label">Open Play Sessions —</span><strong>$7.00</strong></li>
          <li><span class="feat-label">Court Rentals —</span><strong>$20.00 / hr</strong></li>
          <li><span class="feat-label">Ball Machine —</span><strong>$10/hr + court rental</strong></li>
          <li><span class="feat-label">Reserve up to</span><strong>60 days</strong><span class="feat-label">in advance</span></li>
          <li><span class="feat-label">Additional benefits included</span></li>
          <li><span class="feat-label">Save</span><strong>$30 vs 12 monthly payments</strong></li>
        </ul>
        <div class="pcard-actions">
          <CourtReserveButton to="membershipAnnual" label="Join Annual — $150/Yr" />
        </div>
      </div>

    </div>

    <!-- SUMMER SPECIAL BANNER -->
    <!-- TEMPORARY: Remove this banner after August 31, 2026 -->
    <div class="summer-banner">
      <div class="summer-banner-left">
        <span class="summer-badge">★ Summer Special</span>
        <h3>Unlimited Open Play — Available Seasonally</h3>
        <p>During the summer we offer an unlimited open play membership so you can show up as many times as you want for one flat monthly rate. Check CourtReserve or call us to see if the summer rate is currently active.</p>
      </div>
      <a class="btn btn-ghost" href="https://app.courtreserve.com/Online/Memberships/Public/9518" target="_blank" rel="noopener">Check Availability →</a>
    </div>

    <!-- INSURANCE / WELLNESS -->
    <div class="insurance-wrap">
      <div class="insurance-header">
        <span class="insurance-icon" aria-hidden="true">⚡</span>
        <div>
          <h3>We Accept Insurance Fitness &amp; Wellness Programs</h3>
          <p>Use your existing health benefits to play pickleball at FLX</p>
        </div>
      </div>
      <div class="insurance-grid">
        <a href="https://app.courtreserve.com/Online/Memberships/Public/9518" target="_blank" rel="noopener" class="ins-card">
          <span class="ins-icon" aria-hidden="true">🛡</span>
          <div>
            <strong>Silver &amp; Fit</strong>
            <span>Click to enroll</span>
          </div>
        </a>
        <a href="https://app.courtreserve.com/Online/Memberships/Public/9518" target="_blank" rel="noopener" class="ins-card">
          <span class="ins-icon" aria-hidden="true">🛡</span>
          <div>
            <strong>Renew Active</strong>
            <span>Click to enroll</span>
          </div>
        </a>
        <a href="https://app.courtreserve.com/Online/Memberships/Public/9518" target="_blank" rel="noopener" class="ins-card">
          <span class="ins-icon" aria-hidden="true">🛡</span>
          <div>
            <strong>Silver Sneakers</strong>
            <span>Click to enroll</span>
          </div>
        </a>
      </div>
      <p class="insurance-note">Not sure if your plan qualifies? <a href="tel:6077352965">Call us at 607-735-2965</a> and we'll help you find out.</p>
    </div>

    <p class="questions-line">Questions about membership? <a href="tel:6077352965">Call us at 607-735-2965</a> — we're happy to walk you through everything.</p>

  </div>
</section>

<!-- FINAL CTA -->
<div class="mem-final">
  <div class="wrap">
    <h2>Ready to join?</h2>
    <p class="mem-final-sub">Sign up takes two minutes on CourtReserve.</p>
    <p class="mem-final-desc">Create your account, choose your membership, and start playing at member rates right away.</p>
    <div class="ctas">
      <CourtReserveButton to="bookCourt" label="Become a Member" />
      <a class="btn btn-ghost" href="tel:6077352965">Call 607-735-2965</a>
    </div>
  </div>
</div>

<style>
/* ── Pricing section head ── */
.pricing-head {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(30px, 5vw, 60px);
  align-items: end;
  margin-bottom: clamp(44px, 5vw, 66px);
}
.pricing-head-right {
  font: 500 1.05rem/1.7 var(--body);
  color: var(--muted);
  margin: 0;
  padding-bottom: 0.5rem;
}

/* ── Card grid ── */
.pcard-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}
.pcard {
  background: rgba(255,255,255,0.03);
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 28px 26px 26px;
  display: flex;
  flex-direction: column;
  gap: 0;
  transition: border-color 0.3s, transform 0.3s var(--ease);
}
.pcard:hover {
  border-color: rgba(61,99,255,0.4);
  transform: translateY(-4px);
}
.pcard--featured {
  border-color: var(--cobalt-hi);
  background: linear-gradient(160deg, rgba(61,99,255,0.08) 0%, rgba(61,99,255,0.02) 100%);
}

/* ── Badge ── */
.pcard-badge {
  display: inline-block;
  font: 700 10px/1 var(--body);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--cobalt-hi);
  background: rgba(61,99,255,0.15);
  border: 1px solid rgba(61,99,255,0.3);
  border-radius: 4px;
  padding: 5px 10px;
  margin-bottom: 14px;
  align-self: flex-start;
}
.pcard-badge--blue {
  color: #fff;
  background: var(--cobalt);
  border-color: var(--cobalt-hi);
}

/* ── Card content ── */
.pcard-title {
  font: 600 1.05rem/1.2 var(--body);
  color: var(--muted);
  margin: 0 0 12px 0;
}
.pcard-price {
  display: flex;
  align-items: baseline;
  gap: 4px;
  margin-bottom: 14px;
}
.pcard-dollar {
  font: 800 2.6rem/1 var(--display);
  color: var(--text);
  text-transform: uppercase;
}
.pcard-dollar-sign {
  font: 700 1.4rem/1 var(--display);
  color: var(--text);
  align-self: flex-start;
  margin-top: 6px;
}
.pcard-amount {
  font: 800 3.6rem/1 var(--display);
  color: var(--text);
}
.pcard-period {
  font: 500 1rem/1 var(--body);
  color: var(--muted);
}
.pcard-desc {
  font: 400 0.9rem/1.6 var(--body);
  color: var(--muted);
  margin: 0 0 18px 0;
  padding-bottom: 18px;
  border-bottom: 1px solid var(--line);
}
.pcard-features {
  list-style: none;
  margin: 0 0 24px 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
  flex: 1;
}
.pcard-features li {
  font: 400 0.92rem/1.4 var(--body);
  color: var(--muted);
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 5px;
}
.pcard-features li::before {
  content: '♦';
  color: var(--cobalt-hi);
  font-size: 0.6rem;
  flex: none;
  margin-top: 2px;
}
.pcard-features strong {
  color: var(--text);
  font-weight: 600;
}
.feat-label {
  color: var(--muted);
}
.pcard-actions {
  margin-top: auto;
}

/* ── Summer Special banner ── */
.summer-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
  margin-top: clamp(30px, 4vw, 50px);
  padding: 28px 32px;
  background: rgba(255,255,255,0.03);
  border: 1px solid var(--line);
  border-radius: 12px;
}
.summer-banner-left { flex: 1; }
.summer-badge {
  display: inline-block;
  font: 700 10px/1 var(--body);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--cobalt-hi);
  background: rgba(61,99,255,0.15);
  border: 1px solid rgba(61,99,255,0.3);
  border-radius: 4px;
  padding: 5px 10px;
  margin-bottom: 12px;
}
.summer-banner h3 {
  font: 600 1.1rem/1.3 var(--body);
  color: var(--text);
  margin: 0 0 8px 0;
}
.summer-banner p {
  font: 400 0.9rem/1.6 var(--body);
  color: var(--muted);
  margin: 0;
}

/* ── Insurance / Wellness ── */
.insurance-wrap {
  margin-top: clamp(20px, 3vw, 30px);
  padding: 28px 32px;
  background: rgba(255,255,255,0.03);
  border: 1px solid var(--line);
  border-radius: 12px;
}
.insurance-header {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  margin-bottom: 22px;
}
.insurance-icon {
  font-size: 1.4rem;
  background: rgba(61,99,255,0.15);
  border: 1px solid rgba(61,99,255,0.3);
  border-radius: 8px;
  padding: 10px;
  flex: none;
}
.insurance-header h3 {
  font: 600 1.05rem/1.3 var(--body);
  color: var(--text);
  margin: 0 0 4px 0;
}
.insurance-header p {
  font: 400 0.9rem/1.4 var(--body);
  color: var(--muted);
  margin: 0;
}
.insurance-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
  margin-bottom: 18px;
}
.ins-card {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 16px;
  background: rgba(255,255,255,0.03);
  border: 1px solid var(--line);
  border-radius: 8px;
  cursor: pointer;
  transition: border-color 0.25s;
}
.ins-card:hover { border-color: rgba(61,99,255,0.4); }
.ins-icon { font-size: 1.1rem; flex: none; }
.ins-card strong {
  display: block;
  font: 600 0.95rem/1.2 var(--body);
  color: var(--text);
}
.ins-card span {
  font: 400 0.82rem/1.2 var(--body);
  color: var(--muted);
}
.insurance-note {
  font: 400 0.88rem/1.5 var(--body);
  color: var(--muted);
  margin: 0;
}
.insurance-note a {
  color: var(--cobalt-hi);
  text-decoration: underline;
}

/* ── Questions line ── */
.questions-line {
  text-align: center;
  font: 400 0.95rem/1.6 var(--body);
  color: var(--muted);
  margin-top: clamp(24px, 3vw, 36px);
}
.questions-line a {
  color: var(--cobalt-hi);
  text-decoration: underline;
}

/* ── Final CTA ── */
.mem-final {
  background: var(--coal);
  padding: clamp(80px, 10vw, 140px) 0;
  text-align: center;
}
.mem-final h2 {
  font: 800 clamp(2.8rem, 6vw, 5rem)/1 var(--display);
  text-transform: uppercase;
  color: var(--text);
  margin: 0 0 16px 0;
}
.mem-final-sub {
  font: 500 clamp(1.4rem, 3vw, 2.2rem)/1.3 var(--serif);
  color: var(--cobalt-hi);
  font-style: italic;
  margin: 0 0 16px 0;
}
.mem-final-desc {
  font: 400 1rem/1.6 var(--body);
  color: var(--muted);
  margin: 0 0 32px 0;
}
.ctas {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
  justify-content: center;
}

/* ── Responsive ── */
@media (max-width: 900px) {
  .pricing-head { grid-template-columns: 1fr; }
  .pcard-grid { grid-template-columns: 1fr; }
  .insurance-grid { grid-template-columns: 1fr; }
  .summer-banner { flex-direction: column; align-items: flex-start; }
}
@media (max-width: 600px) {
  .insurance-wrap { padding: 20px 18px; }
  .summer-banner { padding: 20px 18px; }
}
</style>

</BaseLayout>
