---
import BaseLayout from '../layouts/BaseLayout.astro';
import CourtReserveButton from '../components/CourtReserveButton.astro';

const title = 'Membership Plans & Pricing | FLX Pickleball Club';
const description = 'Affordable membership plans for pickleball players in Horseheads, NY. Monthly, annual, and free options. Play unlimited with member pricing.';
---

<BaseLayout title={title} description={description}>

<!-- MEMBERSHIP PAGE HERO -->
<section class="page-hero">
  <div class="page-hero-bg">
    <img src="/images/flx/hero-member.jpg" alt="FLX members during a match" style="object-position:50% 50%;filter:brightness(0.88) contrast(1.10)">
  </div>
  <div class="wrap page-hero-inner">
    <p class="eyebrow">Membership Plans</p>
    <h1>Play all you want.<br>Seriously.<br><span style="color:transparent;-webkit-text-stroke:1.5px var(--cobalt-hi)">Member pricing.</span></h1>
    <p class="lede">Choose your commitment level. Member pricing makes pickleball affordable — drop in as much as you want and pay less per session.</p>
    <div class="hero-actions">
      <CourtReserveButton to="membershipMonthly" label="Join Today" />
      <a class="btn btn-ghost" href="#faqs">Questions?</a>
    </div>
  </div>
</section>

<!-- PRICING CARDS SECTION -->
<section class="light" id="plans">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow">Three Plans</p>
      <h2 class="display">Pick your level.<br><span class="serif">Start playing.</span></h2>
      <p class="lede">Whether you play once a month or five days a week, there's a FLX membership for you.</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:clamp(44px,5vw,66px)">

      <!-- FREE MEMBERSHIP -->
      <div class="pcard">
        <div class="pcard-head">
          <h3>Free Membership</h3>
          <p class="pcard-subtitle">Test it out first</p>
        </div>
        <div class="pcard-price">
          <span class="pcard-cost">Free</span>
          <span class="pcard-period">Always</span>
        </div>
        <ul class="pcard-features">
          <li>Drop-in open play</li>
          <li>$10.00 per session</li>
          <li>Access to CourtReserve</li>
          <li>Community access</li>
          <li class="fade">Court rental discounts</li>
          <li class="fade">Member-only events</li>
        </ul>
        <div class="pcard-actions">
          <CourtReserveButton to="membershipFree" label="Start Free" />
        </div>
        <p class="pcard-note">Perfect for trying the club and seeing if pickleball is your thing. Zero commitment.</p>
      </div>

      <!-- MONTHLY MEMBERSHIP -->
      <div class="pcard featured">
        <div class="pcard-badge">Most Popular</div>
        <div class="pcard-head">
          <h3>Monthly Membership</h3>
          <p class="pcard-subtitle">Play whenever</p>
        </div>
        <div class="pcard-price">
          <span class="pcard-cost">$59</span>
          <span class="pcard-period">/month</span>
        </div>
        <ul class="pcard-features">
          <li>Unlimited open play</li>
          <li>$7.00 per session</li>
          <li>Court rental discount</li>
          <li>Member-only events</li>
          <li>Lesson discount (10%)</li>
          <li>Cancel anytime</li>
        </ul>
        <div class="pcard-actions">
          <CourtReserveButton to="membershipMonthly" label="Join Monthly" />
        </div>
        <p class="pcard-note">The everyday player option. Unlimited sessions make this the best value if you play 2+ times per week.</p>
      </div>

      <!-- ANNUAL MEMBERSHIP -->
      <div class="pcard">
        <div class="pcard-head">
          <h3>Annual Membership</h3>
          <p class="pcard-subtitle">Best value</p>
        </div>
        <div class="pcard-price">
          <span class="pcard-cost">$599</span>
          <span class="pcard-period">/year</span>
        </div>
        <ul class="pcard-features">
          <li>Unlimited open play</li>
          <li>$7.00 per session</li>
          <li>Court rental discount</li>
          <li>Member-only events</li>
          <li>Lesson discount (15%)</li>
          <li>Same day cancellation</li>
        </ul>
        <div class="pcard-actions">
          <CourtReserveButton to="membershipAnnual" label="Join Annual" />
        </div>
        <p class="pcard-note">Lock in a full year. Pay ~$50/month but only commit once. Biggest lesson discount too.</p>
      </div>
    </div>

    <!-- SUMMER SPECIAL NOTE -->
    <div style="margin-top:clamp(30px,4vw,50px);padding:20px 24px;background:var(--coal-3);border:1px solid var(--line);border-radius:8px;text-align:center">
      <p style="color:var(--muted);font:500 .95rem/1.5 var(--body);margin:0"><strong style="color:var(--text)">Summer Special:</strong> Join through August 31st and get your first month half off. Monthly and annual plans both apply.</p>
    </div>
  </div>
</section>

<!-- INSURANCE PROGRAMS SECTION -->
<section id="insurance">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow">Optional Add-Ons</p>
      <h2 class="display">Insurance &amp;<br><span class="serif">Protection Plans.</span></h2>
      <p class="lede">Protect yourself with comprehensive pickleball insurance covering injuries, liability, and medical costs.</p>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:clamp(20px,4vw,40px);margin-top:clamp(40px,5vw,60px)">
      <div class="insurance-card">
        <h3>PPA (Professional Pickleball Association) Insurance</h3>
        <p class="ins-desc">Official PPA coverage for competitive play, tournaments, and club liability. Available to all members.</p>
        <ul class="ins-list">
          <li>Tournament play coverage</li>
          <li>Injury protection up to $1M</li>
          <li>Annual membership included</li>
          <li>Affordable rates</li>
        </ul>
        <p class="ins-price">Rates vary by membership level. Ask at the desk or call <a href="tel:6077352965">607-735-2965</a>.</p>
      </div>
      <div class="insurance-card">
        <h3>Club Waiver &amp; Health Forms</h3>
        <p class="ins-desc">Complete your health forms and waiver online through CourtReserve. Required before your first session.</p>
        <ul class="ins-list">
          <li>Quick 5-minute signup</li>
          <li>Required for all players</li>
          <li>Renewal each year</li>
          <li>Store on your account</li>
        </ul>
        <p class="ins-price">Free to complete. <a href="https://app.courtreserve.com/Online/Memberships/Public/9518" target="_blank" rel="noopener">Complete on CourtReserve</a>.</p>
      </div>
    </div>
  </div>
</section>

<!-- FAQ SECTION -->
<section class="light" id="faqs">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow">Questions?</p>
      <h2 class="display">Membership<br><span class="serif">Answered.</span></h2>
    </div>
    <div class="faq-grid">
      <div class="faq-item">
        <h3>How do I sign up for a membership?</h3>
        <p>Sign up through <a href="https://app.courtreserve.com/Online/Memberships/Public/9518" target="_blank" rel="noopener">CourtReserve</a> using the links on this page, or call the club at <a href="tel:6077352965">607-735-2965</a>. You'll choose your plan, enter payment, and complete your waiver. You can start playing the same day.</p>
      </div>
      <div class="faq-item">
        <h3>Can I cancel my membership?</h3>
        <p>Yes. Monthly memberships can be cancelled anytime, and we only charge through the end of your billing cycle. Annual members can cancel with same-day notice. No penalties, no hassle. Just call or log into CourtReserve.</p>
      </div>
      <div class="faq-item">
        <h3>What's the difference between Free and Paid membership?</h3>
        <p>Free members pay $10 per open play session. Paid members get unlimited sessions at $7 per visit (or unlimited, depending on play frequency). Paid members also get court rental and lesson discounts, and access to member-only events.</p>
      </div>
      <div class="faq-item">
        <h3>Do I need to commit to a full year?</h3>
        <p>No. Our monthly plan is month-to-month with no long-term commitment. The annual plan offers better pricing but can be cancelled anytime. And the free membership has zero commitment — start whenever you want.</p>
      </div>
      <div class="faq-item">
        <h3>Can I try out the club before joining?</h3>
        <p>Absolutely. Start with a free membership, come watch a few games, and try open play at member prices. If you love it, upgrade to paid membership anytime. No pressure.</p>
      </div>
      <div class="faq-item">
        <h3>Does my membership include lessons or court rentals?</h3>
        <p>Open play is included (unlimited with paid membership, $10 per session with free). Lessons and court rentals are sold separately but members get discounts. Members also save $20-30 per hour on court rentals.</p>
      </div>
    </div>
  </div>
</section>

<!-- FINAL CTA -->
<div class="inner-final">
  <div class="glow" aria-hidden="true"></div>
  <div class="wrap">
    <h2>Your next rally starts here.<span class="serif">Pick a plan and get on the court.</span></h2>
    <p class="lede">Free to try, affordable to commit, unlimited to play. Membership made simple.</p>
    <div class="ctas">
      <CourtReserveButton to="membershipMonthly" label="Join as a Member" />
      <a class="btn btn-ghost" href="/play">Explore Open Play</a>
    </div>
  </div>
</div>

<style>
.pcard {
  background: var(--coal-3);
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 30px 26px;
  display: flex;
  flex-direction: column;
  position: relative;
  transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease), border-color 0.35s;
}
.pcard:hover {
  transform: translateY(-8px);
  box-shadow: var(--shadow);
  border-color: rgba(61, 99, 255, 0.45);
}
.pcard.featured {
  border-color: var(--cobalt-hi);
  background: linear-gradient(135deg, rgba(61, 99, 255, 0.05) 0%, transparent 100%);
  transform: scale(1.02);
  box-shadow: var(--shadow);
}
.pcard-badge {
  position: absolute;
  top: -12px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--cobalt);
  color: #fff;
  font: 600 11px/1 var(--body);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  padding: 6px 14px;
  border-radius: 20px;
  white-space: nowrap;
}
.pcard-head {
  margin-bottom: 18px;
}
.pcard-head h3 {
  font: 700 1.3rem/1.2 var(--body);
  color: var(--text);
  margin: 0 0 6px 0;
}
.pcard-subtitle {
  font: 500 0.9rem/1.3 var(--body);
  color: var(--muted);
  margin: 0;
}
.pcard-price {
  padding: 18px 0;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  margin-bottom: 22px;
  display: flex;
  align-items: baseline;
  gap: 8px;
}
.pcard-cost {
  font: 800 2.4rem/1 var(--display);
  color: var(--text);
}
.pcard-period {
  font: 500 0.95rem/1 var(--body);
  color: var(--muted);
}
.pcard-features {
  list-style: none;
  margin: 0 0 22px 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
  flex: 1;
}
.pcard-features li {
  font: 500 0.96rem/1.4 var(--body);
  color: var(--muted);
  display: flex;
  align-items: baseline;
  gap: 10px;
}
.pcard-features li::before {
  content: '';
  width: 5px;
  height: 5px;
  background: var(--cobalt);
  border-radius: 50%;
  flex: none;
  margin-top: 3px;
}
.pcard-features li.fade {
  opacity: 0.6;
}
.pcard-actions {
  margin-bottom: 14px;
}
.pcard-note {
  font: 500 0.88rem/1.5 var(--body);
  color: var(--muted);
  margin: 0;
  padding-top: 14px;
  border-top: 1px solid var(--line);
}
.insurance-card {
  background: var(--coal-3);
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 28px 26px;
  transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
}
.insurance-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow);
}
.insurance-card h3 {
  font: 700 1.15rem/1.3 var(--body);
  color: var(--text);
  margin: 0 0 10px 0;
}
.ins-desc {
  font: 500 0.95rem/1.6 var(--body);
  color: var(--muted);
  margin: 0 0 14px 0;
}
.ins-list {
  list-style: none;
  margin: 0 0 14px 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.ins-list li {
  font: 500 0.93rem/1.4 var(--body);
  color: var(--muted);
  display: flex;
  align-items: baseline;
  gap: 8px;
}
.ins-list li::before {
  content: '✓';
  color: var(--cobalt-hi);
  font-weight: 700;
  font-size: 1rem;
  flex: none;
}
.ins-price {
  font: 500 0.9rem/1.5 var(--body);
  color: var(--muted);
  margin: 0;
  padding-top: 14px;
  border-top: 1px solid var(--line);
}
.ins-price a {
  color: var(--cobalt-hi);
  text-decoration: none;
  border-bottom: 1px solid var(--cobalt);
  padding-bottom: 1px;
}
.faq-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 30px;
  margin-top: clamp(44px, 5vw, 66px);
}
.faq-item {
  background: var(--coal-3);
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 28px 26px;
  transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
}
.faq-item:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow);
}
.faq-item h3 {
  font: 700 1.1rem/1.3 var(--body);
  color: var(--text);
  margin: 0 0 12px 0;
}
.faq-item p {
  font: 500 0.95rem/1.6 var(--body);
  color: var(--muted);
  margin: 0;
}
.faq-item a {
  color: var(--cobalt-hi);
  text-decoration: none;
  border-bottom: 1px solid var(--cobalt);
  padding-bottom: 1px;
}
.ctas {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
  margin-top: 30px;
}
@media (max-width: 900px) {
  .pcard {
    transform: none !important;
  }
  .pcard.featured {
    transform: none !important;
  }
  .faq-grid {
    grid-template-columns: 1fr;
  }
}
</style>

</BaseLayout>
