---
import { footerPlayLinks, footerClubLinks } from '../data/nav';
import { siteMeta } from '../data/siteMeta';
import CourtReserveButton from './CourtReserveButton.astro';

const year = new Date().getFullYear();
---

<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <a href="#top" class="logo"><span class="flx">FLX</span><i class="mark" aria-hidden="true"></i><span class="lockup"><b>Pickleball</b><span>Club</span></span></a>
        <p>The indoor home of pickleball in the Horseheads–Elmira region. Six PickleRoll courts, open seven days a week, for every age and level.</p>
      </div>
      <div>
        <h4>Play</h4>
        <CourtReserveButton to="bookCourt" label="Book a Court" variant="link" />
        {footerPlayLinks.map((item) => <a href={item.href}>{item.label}</a>)}
      </div>
      <div>
        <h4>Club</h4>
        {footerClubLinks.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href={siteMeta.facebook} target="_blank" rel="noopener">Facebook</a>
      </div>
      <div>
        <h4>Visit</h4>
        <a href={siteMeta.mapUrl} target="_blank" rel="noopener">{siteMeta.address}</a>
        <a href={siteMeta.phoneHref}>{siteMeta.phone}</a>
      </div>
    </div>
    <div class="foot-bottom">
      <span>&copy; {year} {siteMeta.name}. All rights reserved.</span>
      <span>{siteMeta.city}</span>
    </div>
  </div>
</footer>
